ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_USER=news_platform
POSTGRES_PASSWORD=news_platform_dev
POSTGRES_DB=news_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://news_platform:news_platform_dev@localhost:5432/news_platform
POSTGRES_TEST_URL=postgresql+asyncpg://news_platform:news_platform_dev@localhost:5432/news_platform_test

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
INGESTION_CLOCK_SKEW_SECONDS=300
INGESTION_RATE_LIMIT=300
INGESTION_RATE_LIMIT_WINDOW_SECONDS=60
EDITORIAL_SCHEDULER_ENABLED=true
EDITORIAL_SCHEDULER_POLL_SECONDS=10
EDITORIAL_SCHEDULER_BATCH_SIZE=50
FEED_CACHE_TTL_SECONDS=60
ANALYTICS_EVENT_MAX_AGE_DAYS=7
ANALYTICS_FUTURE_SKEW_SECONDS=300
ANALYTICS_WORKER_ENABLED=true
ANALYTICS_WORKER_POLL_SECONDS=5
ANALYTICS_WORKER_BATCH_SIZE=100
AUTH_SESSION_HOURS=168
AUTH_LOGIN_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMMUNITY_RATE_LIMIT=30
COMMUNITY_RATE_LIMIT_WINDOW_SECONDS=60

WEB_PORT=3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
